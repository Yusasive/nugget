NODE_ENV=development
PORT=3000

# Local Docker Compose defaults (see /docker-compose.yml and root .env.example).
# Point these at Aiven's connection strings for staging/production instead.
DATABASE_URL=postgresql://nugget:nugget@localhost:5432/nugget_dev
REDIS_URL=redis://localhost:6379

CORS_ORIGIN=http://localhost:5173

# Local-only placeholder — generate a real secret per environment for
# staging/production (e.g. `openssl rand -hex 32`), never reuse this one.
JWT_ACCESS_SECRET=999fe696a31af0df122a3fe8b542300ede697db0d783ab7813df462187d37d68
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=7

BOOKING_HOLD_MINUTES=15

# Milestone 5 payment gateways — leave blank in dev until you have real
# sandbox keys; initiating a gateway payment fails with a clear error
# instead of silently calling the provider with an empty key.
# Paystack: https://dashboard.paystack.co/#/settings/developers (test secret key)
PAYSTACK_SECRET_KEY=
# Flutterwave: https://dashboard.flutterwave.com/settings/apis (test secret key)
FLUTTERWAVE_SECRET_KEY=
# Flutterwave's webhook auth: a hash string *you* choose and configure in
# your Flutterwave dashboard's webhook settings — it isn't issued to you.
FLUTTERWAVE_WEBHOOK_HASH=
