// Prisma schema for the Nugget Continental Hotel & Tours platform.
//
// Prisma 7: the connection URL is no longer set here — it lives in
// prisma.config.ts (CLI/migrations) and is passed to the driver adapter at
// runtime (see src/prisma/prisma.service.ts).

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

/// A hotel/restaurant/tours property. Every operationally-scoped table below
/// carries a branchId — see src/prisma/branch-scope.extension.ts for how that
/// scoping is enforced centrally rather than per-module (TRD §3.7).
model Branch {
  id                    String   @id @default(uuid())
  name                  String
  address               String?
  phone                 String?
  email                 String?
  isActive              Boolean  @default(true)
  /// "HH:mm" 24h. Arriving before this on checkInDate triggers the early
  /// check-in fee below (PRD §5.3). No dedicated Settings UI yet — set via
  /// PATCH /branches like every other branch field (see M3 README notes).
  standardCheckInTime   String   @default("14:00")
  /// "HH:mm" 24h. Leaving after this on checkOutDate triggers the late
  /// check-out fee below.
  standardCheckOutTime  String   @default("12:00")
  earlyCheckInFeeAmount Decimal? @db.Decimal(10, 2)
  lateCheckOutFeeAmount Decimal? @db.Decimal(10, 2)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  staff             Staff[]
  departments       Department[]
  auditLogs         AuditLog[]
  roomTypes         RoomType[]
  rooms             Room[]
  ratePlans         RatePlan[]
  bookings          Booking[]
  roomTransfers     RoomTransfer[]
  shifts            Shift[]
  shiftTransactions ShiftTransaction[]
  cashReports       CashReport[]
  folioCharges      FolioCharge[]
  invoices          Invoice[]
  payments          Payment[]
  refunds           Refund[]
  tourGuides        TourGuide[]
  vehicles          Vehicle[]
  tourPackages      TourPackage[]
  tourDepartures    TourDeparture[]
  tourBookings      TourBooking[]
  menuCategories    MenuCategory[]
  menuItems         MenuItem[]
  restaurantTables  RestaurantTable[]
  restaurantOrders  RestaurantOrder[]
  orderItems        OrderItem[]
  suppliers         Supplier[]
  inventoryItems    InventoryItem[]
  stockMovements    StockMovement[]
  purchaseRecords   PurchaseRecord[]
  expenseCategories ExpenseCategory[]
  expenses          Expense[]
  housekeepingTasks HousekeepingTask[]
  attendances       Attendance[]
}

/// Fixed set of seven roles from the PRD's permission matrix (§7). Modeled as
/// a table (per the TRD's ER overview) rather than an enum so the seed data,
/// not a migration, is the source of truth for the exact set in use.
model Role {
  id        String   @id @default(uuid())
  /// Stable machine-readable code, e.g. "SUPER_ADMIN" — referenced by the
  /// @Roles() guard decorator and by the frontend's nav-visibility config.
  name      String   @unique
  label     String
  createdAt DateTime @default(now())

  staff Staff[]
}

/// Minimal for M1 (just enough to assign staff to a department per the
/// milestone's staff-management screens). Full department CRUD/attendance
/// lands in Milestone 11.
model Department {
  id        String   @id @default(uuid())
  branchId  String
  name      String
  /// Milestone 11: soft-disable rather than delete, same pattern as every
  /// other catalog table — a department with historical staff/attendance
  /// attribution must stay queryable even once retired.
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  branch Branch  @relation(fields: [branchId], references: [id])
  staff  Staff[]

  @@unique([branchId, name])
}

model Staff {
  id           String    @id @default(uuid())
  branchId     String
  roleId       String
  departmentId String?
  email        String    @unique
  passwordHash String
  firstName    String
  lastName     String
  phone        String?
  isActive     Boolean   @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  branch                    Branch             @relation(fields: [branchId], references: [id])
  role                      Role               @relation(fields: [roleId], references: [id])
  department                Department?        @relation(fields: [departmentId], references: [id])
  refreshTokens             RefreshToken[]
  auditLogs                 AuditLog[]
  bookingsCreated           Booking[]          @relation("BookingCreatedBy")
  bookingsCheckedIn         Booking[]          @relation("BookingCheckedInBy")
  bookingsCheckedOut        Booking[]          @relation("BookingCheckedOutBy")
  roomTransfersPerformed    RoomTransfer[]
  shiftsWorked              Shift[]
  shiftTransactionsRecorded ShiftTransaction[]
  folioChargesCreated       FolioCharge[]
  invoicesCreated           Invoice[]
  paymentsRecorded          Payment[]
  refundsProcessed          Refund[]
  tourDeparturesCreated     TourDeparture[]
  tourBookingsCreated       TourBooking[]
  restaurantOrdersCreated   RestaurantOrder[]
  stockMovementsRecorded    StockMovement[]
  purchaseRecordsCreated    PurchaseRecord[]
  expensesCreated           Expense[]          @relation("ExpenseCreatedBy")
  expensesApproved          Expense[]          @relation("ExpenseApprovedBy")
  housekeepingTasksAssigned HousekeepingTask[]
  attendances               Attendance[]

  @@index([branchId])
}

/// Hashed, rotated on refresh, revocable — so logout and password-reset
/// flows can invalidate outstanding sessions instead of waiting out the TTL.
model RefreshToken {
  id        String    @id @default(uuid())
  staffId   String
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  staff Staff @relation(fields: [staffId], references: [id])

  @@index([staffId])
}

/// Every mutating endpoint writes one of these in the same transaction
/// (TRD §4) — starting here with staff/branch management since those are
/// the first real mutations in the system.
model AuditLog {
  id         String   @id @default(uuid())
  staffId    String?
  branchId   String?
  action     String
  entityType String
  entityId   String
  metadata   Json?
  createdAt  DateTime @default(now())

  staff  Staff?  @relation(fields: [staffId], references: [id])
  branch Branch? @relation(fields: [branchId], references: [id])

  @@index([branchId])
  @@index([entityType, entityId])
}

/// A category of room (Standard, Deluxe, Suite, ...) per PRD §5.5. Pricing
/// itself lives on RatePlan, not here, so a room type can carry standard,
/// seasonal, corporate, and promotional rates simultaneously.
model RoomType {
  id           String   @id @default(uuid())
  branchId     String
  name         String
  description  String?
  maxOccupancy Int
  amenities    String[] @default([])
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  branch    Branch     @relation(fields: [branchId], references: [id])
  rooms     Room[]
  ratePlans RatePlan[]

  @@unique([branchId, name])
}

enum HousekeepingStatus {
  CLEAN
  DIRTY
}

/// A physical room. `isOutOfOrder` gates it out of availability search
/// (PRD §5.5: "maintenance/out-of-order flagging"). The board's actual
/// vacant/occupied/dirty/out-of-order status (PRD §5.3) is a computed view
/// over isOutOfOrder + housekeepingStatus + whether an active CHECKED_IN
/// booking currently points at this room — see RoomStatusService.
model Room {
  id                 String             @id @default(uuid())
  branchId           String
  roomTypeId         String
  roomNumber         String
  floor              String?
  isOutOfOrder       Boolean            @default(false)
  outOfOrderReason   String?
  outOfOrderUntil    DateTime?
  housekeepingStatus HousekeepingStatus @default(CLEAN)
  isActive           Boolean            @default(true)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  branch            Branch             @relation(fields: [branchId], references: [id])
  roomType          RoomType           @relation(fields: [roomTypeId], references: [id])
  bookings          Booking[]
  transfersFrom     RoomTransfer[]     @relation("TransferFromRoom")
  transfersTo       RoomTransfer[]     @relation("TransferToRoom")
  housekeepingTasks HousekeepingTask[]

  @@unique([branchId, roomNumber])
  @@index([roomTypeId])
}

enum RatePlanType {
  STANDARD
  SEASONAL
  CORPORATE
  PROMOTIONAL
}

/// Per PRD §5.2: "rate plans: standard, seasonal, corporate, and
/// promotional." Seasonal/promotional plans are only eligible within
/// [validFrom, validTo]; standard/corporate plans leave those null and apply
/// year-round. Booking creation takes an explicit ratePlanId rather than
/// auto-picking "best price" — that ranking logic is a product decision
/// better made with real pricing data in front of it, not guessed here.
model RatePlan {
  id            String       @id @default(uuid())
  branchId      String
  roomTypeId    String
  name          String
  type          RatePlanType
  pricePerNight Decimal      @db.Decimal(10, 2)
  validFrom     DateTime?
  validTo       DateTime?
  isActive      Boolean      @default(true)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  branch   Branch    @relation(fields: [branchId], references: [id])
  roomType RoomType  @relation(fields: [roomTypeId], references: [id])
  bookings Booking[]

  @@index([roomTypeId])
}

/// Guests are not branch-scoped — the same person can book across branches
/// and their full history should be visible as one profile (PRD §5.6).
/// VIP/blacklist flags and preferences are Milestone 10 additions.
model Guest {
  id            String   @id @default(uuid())
  firstName     String
  lastName      String
  email         String?
  phone         String?
  preferences   String?
  notes         String?
  isVip         Boolean  @default(false)
  isBlacklisted Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  bookings         Booking[]
  invoices         Invoice[]
  tourBookings     TourBooking[]
  restaurantOrders RestaurantOrder[]

  @@index([email])
}

enum BookingStatus {
  /// Reserved but not yet paid/confirmed; expires automatically at holdExpiresAt.
  HELD
  CONFIRMED
  /// Guest is physically in the room (PRD §5.3 check-in). Still blocks
  /// availability for its dates, same as CONFIRMED.
  CHECKED_IN
  /// Guest has departed. Does not block availability — the room simply
  /// needs cleaning first (housekeepingStatus), which is a separate gate.
  CHECKED_OUT
  CANCELLED
  EXPIRED
}

enum BookingSource {
  STAFF_MANUAL
  GUEST_ONLINE
}

/// checkInDate/checkOutDate are date-only values (stored at UTC midnight);
/// a stay is [checkInDate, checkOutDate) — checkout day itself is not booked.
/// Double-booking prevention (PRD §5.2, TRD §6) happens in two layers, both
/// required: a short-lived Redis lock on the room (src/redis/redis-lock.service.ts)
/// serializes concurrent attempts before they reach the database, and the
/// overlap check + insert run inside one Postgres transaction as the
/// authoritative backstop even if the lock were ever bypassed or expired early.
model Booking {
  id               String        @id @default(uuid())
  branchId         String
  roomId           String
  ratePlanId       String
  guestId          String
  checkInDate      DateTime
  checkOutDate     DateTime
  status           BookingStatus @default(HELD)
  holdExpiresAt    DateTime?
  totalAmount      Decimal       @db.Decimal(10, 2)
  source           BookingSource
  createdByStaffId String?
  notes            String?

  /// Fields below are populated by the Milestone 3 front-desk lifecycle;
  /// null until the corresponding transition happens.
  checkedInAt         DateTime?
  checkedInByStaffId  String?
  checkedOutAt        DateTime?
  checkedOutByStaffId String?
  depositAmount       Decimal?  @db.Decimal(10, 2)
  /// Charged at check-in if arrival is before the branch's standardCheckInTime.
  earlyCheckInFee     Decimal?  @db.Decimal(10, 2)
  /// Charged at check-out if departure is after the branch's standardCheckOutTime.
  lateCheckOutFee     Decimal?  @db.Decimal(10, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  branch            Branch             @relation(fields: [branchId], references: [id])
  room              Room               @relation(fields: [roomId], references: [id])
  ratePlan          RatePlan           @relation(fields: [ratePlanId], references: [id])
  guest             Guest              @relation(fields: [guestId], references: [id])
  createdByStaff    Staff?             @relation("BookingCreatedBy", fields: [createdByStaffId], references: [id])
  checkedInBy       Staff?             @relation("BookingCheckedInBy", fields: [checkedInByStaffId], references: [id])
  checkedOutBy      Staff?             @relation("BookingCheckedOutBy", fields: [checkedOutByStaffId], references: [id])
  roomTransfers     RoomTransfer[]
  shiftTransactions ShiftTransaction[]
  folioCharges      FolioCharge[]
  invoices          Invoice[]
  /// Tours booked as an add-on to this room stay (TourBooking.linkedBookingId)
  /// — Milestone 6. Billed via a FolioCharge on this booking, not their own Invoice.
  tourBookings      TourBooking[]
  /// Room-service orders billed to this stay (RestaurantOrder.roomBookingId)
  /// — Milestone 7. Billed via a FolioCharge on this booking, same as tours above.
  restaurantOrders  RestaurantOrder[]

  @@index([branchId])
  @@index([roomId, checkInDate, checkOutDate])
}

/// Audit trail for PRD §5.3 room transfers — the Booking row itself is
/// mutated to point at the new room (so folio/rate-plan history stays in one
/// place), and this table is what lets a stay's room history be reconstructed.
model RoomTransfer {
  id                   String   @id @default(uuid())
  branchId             String
  bookingId            String
  fromRoomId           String
  toRoomId             String
  reason               String?
  transferredByStaffId String
  transferredAt        DateTime @default(now())

  branch             Branch  @relation(fields: [branchId], references: [id])
  booking            Booking @relation(fields: [bookingId], references: [id])
  fromRoom           Room    @relation("TransferFromRoom", fields: [fromRoomId], references: [id])
  toRoom             Room    @relation("TransferToRoom", fields: [toRoomId], references: [id])
  transferredByStaff Staff   @relation(fields: [transferredByStaffId], references: [id])

  @@index([bookingId])
  @@index([branchId])
}

enum ShiftStatus {
  OPEN
  CLOSED
}

/// PRD §5.4: a Front Desk staff member's working session. Cash sales are
/// attributed to whichever shift is open for the acting staff member
/// (ShiftTransaction) and reconciled when the shift closes. One staff member
/// having at most one OPEN shift at a time is enforced in ShiftService, not
/// here — a partial unique index ("one row per staffId where status = OPEN")
/// isn't expressible in Prisma's schema DSL.
model Shift {
  id                  String      @id @default(uuid())
  branchId            String
  staffId             String
  openedAt            DateTime    @default(now())
  closedAt            DateTime?
  openingCash         Decimal     @db.Decimal(10, 2)
  /// openingCash plus net cash transactions — computed at close, not before.
  closingCashExpected Decimal?    @db.Decimal(10, 2)
  /// What the staff member actually counted in the drawer at close.
  closingCashActual   Decimal?    @db.Decimal(10, 2)
  status              ShiftStatus @default(OPEN)
  notes               String?
  createdAt           DateTime    @default(now())

  branch       Branch             @relation(fields: [branchId], references: [id])
  staff        Staff              @relation(fields: [staffId], references: [id])
  transactions ShiftTransaction[]
  cashReport   CashReport?

  @@index([branchId])
  @@index([staffId, status])
}

enum ShiftTransactionType {
  CASH_IN
  CASH_OUT
}

/// A single cash movement attributed to an open shift (PRD §5.4's "daily
/// sales entry"). Some rows are created automatically — a check-in deposit,
/// via BookingService.checkIn — and some are entered manually by Front Desk
/// for anything else the drawer handles that isn't its own model yet (the
/// full invoice/payment system arrives in Milestone 5).
model ShiftTransaction {
  id                String               @id @default(uuid())
  branchId          String
  shiftId           String
  type              ShiftTransactionType
  amount            Decimal              @db.Decimal(10, 2)
  description       String?
  bookingId         String?
  recordedByStaffId String
  recordedAt        DateTime             @default(now())

  branch          Branch   @relation(fields: [branchId], references: [id])
  shift           Shift    @relation(fields: [shiftId], references: [id])
  booking         Booking? @relation(fields: [bookingId], references: [id])
  recordedByStaff Staff    @relation(fields: [recordedByStaffId], references: [id])

  @@index([shiftId])
  @@index([branchId])
}

/// Snapshot produced once, at shift close (PRD §5.4) — kept as its own table
/// rather than columns on Shift because it's the read model an Accountant
/// consolidates across every shift (GET /cash-reports), while a Front Desk
/// staff member may only ever see their own (TRD §5's staff-scoped rule,
/// stricter than ordinary branch scoping — enforced in ShiftService).
/// totalSales and totalCashCollected are equal for now: every collection
/// modeled before Milestone 5's payment gateways is cash by definition.
model CashReport {
  id                 String   @id @default(uuid())
  branchId           String
  shiftId            String   @unique
  totalSales         Decimal  @db.Decimal(10, 2)
  totalCashCollected Decimal  @db.Decimal(10, 2)
  discrepancy        Decimal  @db.Decimal(10, 2)
  notes              String?
  createdAt          DateTime @default(now())

  branch Branch @relation(fields: [branchId], references: [id])
  shift  Shift  @relation(fields: [shiftId], references: [id])

  @@index([branchId])
}

enum FolioChargeCategory {
  INCIDENTAL
  FEE
  /// A tour booked against an existing room stay (TourBooking.linkedBookingId)
  /// lands here — Milestone 6.
  TOUR
  /// A room-service order billed to the stay (RestaurantOrder.roomBookingId)
  /// lands here — Milestone 7, same "ride the room's folio" pattern as TOUR.
  RESTAURANT
}

/// PRD §5.7's guest folio is a computed view (FolioService), not a table —
/// the room charge and its fees already live on Booking (Milestone 3). This
/// table is only the *additional* line items a folio can carry: minibar,
/// damages, extra services, and the like.
model FolioCharge {
  id               String              @id @default(uuid())
  branchId         String
  bookingId        String
  category         FolioChargeCategory @default(INCIDENTAL)
  description      String
  amount           Decimal             @db.Decimal(10, 2)
  createdByStaffId String
  createdAt        DateTime            @default(now())

  branch         Branch  @relation(fields: [branchId], references: [id])
  booking        Booking @relation(fields: [bookingId], references: [id])
  createdByStaff Staff   @relation(fields: [createdByStaffId], references: [id])

  @@index([bookingId])
  @@index([branchId])
}

/// ISSUED/VOID is the only lifecycle this table stores — PAID/PARTIALLY_PAID
/// are derived from the Payment/Refund ledger at read time (InvoiceService),
/// the same "computed, not stored" choice made for the room-status board in
/// Milestone 3, for the same reason: a stored payment-status column could
/// disagree with the actual ledger; a derived one structurally can't.
/// `sequenceNumber` is a plain autoincrement so invoice numbers displayed to
/// guests (INV-000123) are stable and gap-free without a hand-rolled counter.
enum InvoiceStatus {
  ISSUED
  VOID
}

model Invoice {
  id                String        @id @default(uuid())
  branchId          String
  /// Milestone 6/7: nullable because a standalone tour or restaurant order
  /// (no room stay) has no Booking to invoice against. Exactly one of
  /// bookingId/tourBookingId/restaurantOrderId is set — enforced in
  /// InvoiceService, not the schema, same as this codebase's other
  /// cross-field invariants Prisma's DSL can't express directly. A bundled
  /// tour (TourBooking.linkedBookingId set) or room-service order
  /// (RestaurantOrder.roomBookingId set) never gets its own invoice — it
  /// rides the room stay's folio/invoice via a FolioCharge instead (see
  /// FolioChargeCategory.TOUR / .RESTAURANT).
  bookingId         String?
  tourBookingId     String?
  restaurantOrderId String?
  /// Milestone 7: nullable because a dine-in/takeaway restaurant order can
  /// be an anonymous walk-in with no guest record at all — unlike a room
  /// booking or tour booking, which always have one. A guest is still
  /// required to initiate a gateway payment (PaymentService checks this),
  /// just not to issue the invoice itself.
  guestId           String?
  sequenceNumber    Int           @default(autoincrement())
  status            InvoiceStatus @default(ISSUED)
  /// Snapshot of booking total + fees + folio charges (or, for a standalone
  /// tour invoice, the TourBooking's totalAmount) at the moment of issuance —
  /// fixed once issued, unlike the live folio it was built from.
  totalAmount       Decimal       @db.Decimal(10, 2)
  issuedAt          DateTime      @default(now())
  voidedAt          DateTime?
  createdByStaffId  String
  createdAt         DateTime      @default(now())

  branch          Branch           @relation(fields: [branchId], references: [id])
  booking         Booking?         @relation(fields: [bookingId], references: [id])
  tourBooking     TourBooking?     @relation(fields: [tourBookingId], references: [id])
  restaurantOrder RestaurantOrder? @relation(fields: [restaurantOrderId], references: [id])
  guest           Guest?           @relation(fields: [guestId], references: [id])
  createdByStaff  Staff            @relation(fields: [createdByStaffId], references: [id])
  payments        Payment[]

  @@index([bookingId])
  @@index([tourBookingId])
  @@index([restaurantOrderId])
  @@index([branchId])
}

enum PaymentMethod {
  CASH
  CARD
  BANK_TRANSFER
  USSD
}

enum PaymentProvider {
  MANUAL
  PAYSTACK
  FLUTTERWAVE
}

enum PaymentStatus {
  PENDING
  SUCCESSFUL
  FAILED
  REFUNDED
  PARTIALLY_REFUNDED
}

/// A MANUAL payment (cash/POS collected in person) is recorded as already
/// SUCCESSFUL — staff is logging money already in hand. A PAYSTACK/
/// FLUTTERWAVE payment starts PENDING with a providerReference from the
/// gateway's initialize call, and only becomes SUCCESSFUL once the gateway
/// confirms it — via webhook (PaymentsWebhookController) or a manual
/// GET-verify call — never from the client's say-so (TRD §10).
model Payment {
  id                String          @id @default(uuid())
  branchId          String
  invoiceId         String
  amount            Decimal         @db.Decimal(10, 2)
  method            PaymentMethod
  provider          PaymentProvider
  providerReference String?         @unique
  status            PaymentStatus   @default(PENDING)
  /// Null for a payment that isn't attributable to any staff member's
  /// in-person action (a gateway payment awaiting confirmation, say).
  recordedByStaffId String?
  paidAt            DateTime?
  failureReason     String?
  createdAt         DateTime        @default(now())

  branch          Branch   @relation(fields: [branchId], references: [id])
  invoice         Invoice  @relation(fields: [invoiceId], references: [id])
  recordedByStaff Staff?   @relation(fields: [recordedByStaffId], references: [id])
  refunds         Refund[]

  @@index([invoiceId])
  @@index([branchId])
}

enum RefundStatus {
  PENDING
  SUCCESSFUL
  FAILED
}

model Refund {
  id                 String          @id @default(uuid())
  branchId           String
  paymentId          String
  amount             Decimal         @db.Decimal(10, 2)
  reason             String?
  provider           PaymentProvider
  providerReference  String?         @unique
  status             RefundStatus    @default(PENDING)
  processedByStaffId String?
  processedAt        DateTime?
  createdAt          DateTime        @default(now())

  branch           Branch  @relation(fields: [branchId], references: [id])
  payment          Payment @relation(fields: [paymentId], references: [id])
  processedByStaff Staff?  @relation(fields: [processedByStaffId], references: [id])

  @@index([paymentId])
  @@index([branchId])
}

// ---------------------------------------------------------------------------
// Milestone 10 — Housekeeping Tasks
// ---------------------------------------------------------------------------

enum HousekeepingTaskStatus {
  PENDING
  IN_PROGRESS
  DONE
}

/// PRD §5.12: per-room task assignment and completion tracking. Completing a
/// task whose type is CLEAN automatically sets the room's housekeepingStatus
/// to CLEAN (handled in HousekeepingTaskService.complete), which is what
/// gates the room back into availability for check-in/transfer (M3).
model HousekeepingTask {
  id                String                 @id @default(uuid())
  branchId          String
  roomId            String
  assignedToStaffId String?
  description       String
  status            HousekeepingTaskStatus @default(PENDING)
  completedAt       DateTime?
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt

  branch          Branch @relation(fields: [branchId], references: [id])
  room            Room   @relation(fields: [roomId], references: [id])
  assignedToStaff Staff? @relation(fields: [assignedToStaffId], references: [id])

  @@index([branchId])
  @@index([roomId])
}

// ---------------------------------------------------------------------------
// Milestone 6 — Tours & Packages Module
// ---------------------------------------------------------------------------

/// A person who leads tours (PRD §5.8). Deliberately not a Staff row: guides
/// are frequently contractors who never need system login, the same reason
/// Guest isn't modeled as a Staff-adjacent table either.
model TourGuide {
  id        String   @id @default(uuid())
  branchId  String
  fullName  String
  phone     String?
  email     String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  branch     Branch          @relation(fields: [branchId], references: [id])
  departures TourDeparture[]

  @@index([branchId])
}

/// A vehicle used to run a tour departure (PRD §5.8 "vehicle assignment").
/// `capacity` is informational (helps a coordinator pick a vehicle that can
/// actually seat the departure) — TourDeparture.totalSeats is the value that
/// actually gates bookings, since a departure may intentionally sell fewer
/// seats than the vehicle holds.
model Vehicle {
  id          String   @id @default(uuid())
  branchId    String
  name        String
  plateNumber String?
  capacity    Int
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  branch     Branch          @relation(fields: [branchId], references: [id])
  departures TourDeparture[]

  @@unique([branchId, plateNumber])
  @@index([branchId])
}

/// The sellable catalog entry (PRD §5.8: "itinerary, duration, price,
/// capacity, and images"). Price/capacity here are just the *defaults* a new
/// TourDeparture is seeded from — each departure snapshots its own
/// pricePerSeat/totalSeats at creation time, the same reasoning as RatePlan
/// vs. Booking.totalAmount: a later catalog price change must never
/// retroactively change a departure that's already scheduled or already has
/// bookings against it.
model TourPackage {
  id                  String   @id @default(uuid())
  branchId            String
  name                String
  description         String?
  /// Free-text itinerary (day-by-day plan) — no structured step-by-step
  /// itinerary model in v1, PRD only asks that it be captured and shown.
  itinerary           String?
  durationMinutes     Int
  defaultPricePerSeat Decimal  @db.Decimal(10, 2)
  defaultCapacity     Int
  /// Plain URLs, not an upload pipeline — no file-upload infra exists
  /// anywhere else in this codebase yet (same "just a string array" treatment
  /// as RoomType.amenities).
  imageUrls           String[] @default([])
  isActive            Boolean  @default(true)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  branch     Branch          @relation(fields: [branchId], references: [id])
  departures TourDeparture[]

  @@unique([branchId, name])
  @@index([branchId])
}

enum TourDepartureStatus {
  SCHEDULED
  CANCELLED
  COMPLETED
}

/// A scheduled, bookable instance of a TourPackage — the tours-module
/// analogue of a specific room+date range. Guide/vehicle double-booking
/// prevention (TRD: "applies to tour_departures and guides/vehicles as in
/// v1.0") uses the same two-layer defense as Booking/Room: a Redis lock (on
/// both `lock:tour-guide:<id>` and `lock:vehicle:<id>`, nested — see
/// src/redis/redis-lock.service.ts) serializes concurrent scheduling
/// attempts, and a row-locked overlap query inside one Postgres transaction
/// is the authoritative backstop. Available seats are NEVER stored — they
/// are `totalSeats - sum(active TourBooking.seats)`, computed at read time,
/// the same "computed, not stored" choice made for the room-status board and
/// Invoice's payment status.
model TourDeparture {
  id               String              @id @default(uuid())
  branchId         String
  tourPackageId    String
  guideId          String
  vehicleId        String
  departureAt      DateTime
  returnAt         DateTime
  totalSeats       Int
  /// Snapshot of TourPackage.defaultPricePerSeat at creation time — see the
  /// TourPackage doc comment for why.
  pricePerSeat     Decimal             @db.Decimal(10, 2)
  status           TourDepartureStatus @default(SCHEDULED)
  createdByStaffId String?
  notes            String?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  branch         Branch        @relation(fields: [branchId], references: [id])
  tourPackage    TourPackage   @relation(fields: [tourPackageId], references: [id])
  guide          TourGuide     @relation(fields: [guideId], references: [id])
  vehicle        Vehicle       @relation(fields: [vehicleId], references: [id])
  createdByStaff Staff?        @relation(fields: [createdByStaffId], references: [id])
  bookings       TourBooking[]

  @@index([branchId])
  @@index([tourPackageId])
  @@index([guideId, departureAt, returnAt])
  @@index([vehicleId, departureAt, returnAt])
}

enum TourBookingStatus {
  /// Reserved but not yet paid/confirmed; expires automatically at holdExpiresAt.
  HELD
  CONFIRMED
  CANCELLED
  EXPIRED
}

/// A guest's reservation of N seats on a TourDeparture (PRD §5.8's "standalone
/// or bundled with a room stay"). Seat-availability double-booking prevention
/// mirrors Booking exactly: a Redis lock on `lock:tour-departure:<id>`
/// serializes concurrent seat requests, and the authoritative check —
/// `totalSeats - sum(active bookings' seats) >= requested seats` — runs under
/// a row-locked read inside the same Postgres transaction as the insert.
/// `linkedBookingId` is set when a guest books a tour as part of an existing
/// room stay; billing then rides that Booking's folio (FolioService.addCharge,
/// category TOUR) instead of a standalone Invoice.
model TourBooking {
  id               String            @id @default(uuid())
  branchId         String
  tourDepartureId  String
  guestId          String
  seats            Int
  status           TourBookingStatus @default(HELD)
  holdExpiresAt    DateTime?
  totalAmount      Decimal           @db.Decimal(10, 2)
  source           BookingSource
  createdByStaffId String?
  linkedBookingId  String?
  notes            String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  branch         Branch        @relation(fields: [branchId], references: [id])
  tourDeparture  TourDeparture @relation(fields: [tourDepartureId], references: [id])
  guest          Guest         @relation(fields: [guestId], references: [id])
  createdByStaff Staff?        @relation(fields: [createdByStaffId], references: [id])
  linkedBooking  Booking?      @relation(fields: [linkedBookingId], references: [id])
  invoices       Invoice[]

  @@index([branchId])
  @@index([tourDepartureId])
  @@index([guestId])
  @@index([linkedBookingId])
}

// ---------------------------------------------------------------------------
// Milestone 7 — Restaurant POS: Menu, Tables & Orders
// ---------------------------------------------------------------------------

/// PRD §5.9 menu structure (categories, items). displayOrder controls the
/// order categories render in on the POS order-entry grid and the guest-
/// facing menu display.
model MenuCategory {
  id           String   @id @default(uuid())
  branchId     String
  name         String
  displayOrder Int      @default(0)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  branch Branch     @relation(fields: [branchId], references: [id])
  items  MenuItem[]

  @@unique([branchId, name])
  @@index([branchId])
}

/// `isAvailable` is the "86'd" toggle (PRD §5.9) — a category isn't hidden
/// wholesale, individual items are turned off when the kitchen runs out.
model MenuItem {
  id          String   @id @default(uuid())
  branchId    String
  categoryId  String
  name        String
  description String?
  price       Decimal  @db.Decimal(10, 2)
  isAvailable Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  branch     Branch       @relation(fields: [branchId], references: [id])
  category   MenuCategory @relation(fields: [categoryId], references: [id])
  orderItems OrderItem[]

  @@index([branchId])
  @@index([categoryId])
}

enum RestaurantTableStatus {
  FREE
  OCCUPIED
  RESERVED
  NEEDS_CLEANING
}

/// PRD §5.9 table management. Unlike the Room board (Milestone 3), status
/// here is a stored column, not computed — there's no independent
/// booking/housekeeping signal to derive it from, so staff (and
/// RestaurantOrderService, on order create/cancel/bill) set it directly.
/// Table assignment on order creation is protected the same two-layer way
/// as room booking (TRD §6): a Redis lock on `lock:restaurant-table:<id>`
/// serializes concurrent seating attempts, and the status re-check happens
/// inside the same Postgres transaction as the order insert.
model RestaurantTable {
  id          String                @id @default(uuid())
  branchId    String
  tableNumber String
  capacity    Int
  status      RestaurantTableStatus @default(FREE)
  isActive    Boolean               @default(true)
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt

  branch Branch            @relation(fields: [branchId], references: [id])
  orders RestaurantOrder[]

  @@unique([branchId, tableNumber])
  @@index([branchId])
}

enum RestaurantOrderType {
  DINE_IN
  ROOM_SERVICE
  TAKEAWAY
}

/// PRD §5.9 / TRD §3.3 order lifecycle. PAID means billing has been
/// finalized for the order — either a FolioCharge was landed on a linked
/// room stay, or a standalone Invoice was issued — not that a payment has
/// necessarily been reconciled yet for a standalone invoice; that follows
/// the existing Invoice/Payment flow independently, the same separation of
/// concerns Booking/Invoice already keep (see InvoiceService).
enum RestaurantOrderStatus {
  OPEN
  SENT_TO_KITCHEN
  SERVED
  PAID
  CANCELLED
}

/// tableId is set only for DINE_IN orders; roomBookingId only for
/// ROOM_SERVICE. TAKEAWAY needs neither. Exactly the right field set per
/// orderType is enforced in RestaurantOrderService, not the schema, same as
/// this codebase's other cross-field invariants (e.g. Invoice's
/// booking/tourBooking/restaurantOrder exclusivity).
model RestaurantOrder {
  id               String                @id @default(uuid())
  branchId         String
  tableId          String?
  orderType        RestaurantOrderType
  guestId          String?
  roomBookingId    String?
  status           RestaurantOrderStatus @default(OPEN)
  createdByStaffId String
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt

  branch         Branch           @relation(fields: [branchId], references: [id])
  table          RestaurantTable? @relation(fields: [tableId], references: [id])
  guest          Guest?           @relation(fields: [guestId], references: [id])
  roomBooking    Booking?         @relation(fields: [roomBookingId], references: [id])
  createdByStaff Staff            @relation(fields: [createdByStaffId], references: [id])
  items          OrderItem[]
  invoices       Invoice[]

  @@index([branchId])
  @@index([tableId])
  @@index([roomBookingId])
}

enum KitchenItemStatus {
  PENDING
  PREPARING
  READY
  SERVED
}

/// The KOT pipeline (TRD §3.3): each line item flows PENDING → PREPARING →
/// READY → SERVED independently, tracked here rather than only at the order
/// level, since a kitchen may finish one item before another.
/// unitPriceAtOrder snapshots MenuItem.price at the moment the item was
/// added — the same "snapshot, don't let a later catalog change retroactively
/// alter an existing order" reasoning as RatePlan vs. Booking.totalAmount.
model OrderItem {
  id               String            @id @default(uuid())
  branchId         String
  orderId          String
  menuItemId       String
  quantity         Int
  notes            String?
  kitchenStatus    KitchenItemStatus @default(PENDING)
  unitPriceAtOrder Decimal           @db.Decimal(10, 2)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  branch   Branch          @relation(fields: [branchId], references: [id])
  order    RestaurantOrder @relation(fields: [orderId], references: [id])
  menuItem MenuItem        @relation(fields: [menuItemId], references: [id])

  @@index([orderId])
  @@index([menuItemId])
}

// ---------------------------------------------------------------------------
// Milestone 8 — Restaurant Inventory & Suppliers
// ---------------------------------------------------------------------------

/// PRD §5.10 supplier profile. Not branch-shared across the company —
/// each branch runs its own supplier relationships, same reasoning as
/// TourGuide/Vehicle being per-branch rather than global.
model Supplier {
  id           String   @id @default(uuid())
  branchId     String
  name         String
  phone        String?
  contactNotes String?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  branch          Branch           @relation(fields: [branchId], references: [id])
  purchaseRecords PurchaseRecord[]

  @@index([branchId])
}

/// PRD §5.10 raw-material inventory. `quantityOnHand` is a stored running
/// total (unlike the room/table-status "computed, not stored" pattern
/// elsewhere in this codebase) because it's cheaper to maintain
/// incrementally under each StockMovement than to re-sum the movement
/// ledger on every read, and Postgres row-level locking on this column
/// (see StockMovementService) is what actually prevents a lost update under
/// concurrent stock in/out — the ledger below is the audit trail, not the
/// source of truth for "what do we have right now."
model InventoryItem {
  id               String   @id @default(uuid())
  branchId         String
  name             String
  /// Free-text unit of measure (kg, l, pcs, ...) — no UoM conversion table,
  /// same "just a string" scope cut as RoomType.amenities.
  unit             String
  quantityOnHand   Decimal  @default(0) @db.Decimal(12, 3)
  reorderThreshold Decimal  @db.Decimal(12, 3)
  unitCost         Decimal  @db.Decimal(10, 2)
  isActive         Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  branch         Branch          @relation(fields: [branchId], references: [id])
  stockMovements StockMovement[]

  @@unique([branchId, name])
  @@index([branchId])
}

enum StockMovementType {
  IN
  OUT
}

enum StockMovementReason {
  PURCHASE
  CONSUMPTION
  WASTE
  ADJUSTMENT
}

/// The append-only audit trail behind InventoryItem.quantityOnHand (TRD
/// §3.4). `referenceId` is a loose, unenforced pointer (a PurchaseRecord id
/// for PURCHASE, nothing yet for CONSUMPTION until the kitchen-to-inventory
/// link is built) rather than a real FK — it points at different tables
/// depending on `reason`, which Prisma can't express as one relation.
model StockMovement {
  id               String              @id @default(uuid())
  branchId         String
  inventoryItemId  String
  type             StockMovementType
  quantity         Decimal             @db.Decimal(12, 3)
  reason           StockMovementReason
  referenceId      String?
  createdByStaffId String
  createdAt        DateTime            @default(now())

  branch           Branch          @relation(fields: [branchId], references: [id])
  inventoryItem    InventoryItem   @relation(fields: [inventoryItemId], references: [id])
  createdByStaff   Staff           @relation(fields: [createdByStaffId], references: [id])
  purchaseRecord   PurchaseRecord? @relation(fields: [purchaseRecordId], references: [id])
  purchaseRecordId String?

  @@index([inventoryItemId])
  @@index([branchId])
}

/// PRD §5.10 purchase record. `lineItems` is a JSONB snapshot (TRD §3.4:
/// "item, quantity, unit_cost") rather than a normalized line-item table —
/// each line becomes its own StockMovement row on creation (the real,
/// queryable ledger); this JSON is just the receipt-shaped record of what
/// was actually purchased in one transaction with one supplier.
model PurchaseRecord {
  id               String   @id @default(uuid())
  branchId         String
  supplierId       String
  lineItems        Json
  totalCost        Decimal  @db.Decimal(10, 2)
  purchasedAt      DateTime @default(now())
  createdByStaffId String
  createdAt        DateTime @default(now())

  branch         Branch          @relation(fields: [branchId], references: [id])
  supplier       Supplier        @relation(fields: [supplierId], references: [id])
  createdByStaff Staff           @relation(fields: [createdByStaffId], references: [id])
  stockMovements StockMovement[]
  expense        Expense?

  @@index([branchId])
  @@index([supplierId])
}

/// PRD §5.11 expense categories: utilities, salaries, maintenance,
/// restaurant_purchases, custom. branchId nullable so Super Admin can seed
/// company-wide defaults (e.g. "Restaurant Purchases", auto-resolved by
/// PurchaseRecordService) alongside branch-specific custom categories.
model ExpenseCategory {
  id        String   @id @default(uuid())
  branchId  String?
  name      String
  createdAt DateTime @default(now())

  branch   Branch?   @relation(fields: [branchId], references: [id])
  expenses Expense[]

  @@index([branchId])
}

enum ExpenseStatus {
  PENDING
  APPROVED
  REJECTED
}

/// PRD §5.11. The approval flow itself (who may set approvedByStaffId/
/// status, expense reports, P&L) is Milestone 9 scope — this table exists
/// now only because TRD §4 requires a purchase record to create an expense
/// row in the same transaction as its stock movements (see
/// PurchaseRecordService). `purchaseRecordId` is null for every expense
/// type Milestone 9 will add (utilities, salaries, ...) that doesn't
/// originate from a purchase.
model Expense {
  id                String        @id @default(uuid())
  branchId          String
  categoryId        String
  purchaseRecordId  String?       @unique
  amount            Decimal       @db.Decimal(10, 2)
  description       String
  incurredAt        DateTime      @default(now())
  createdByStaffId  String
  approvedByStaffId String?
  status            ExpenseStatus @default(PENDING)
  createdAt         DateTime      @default(now())

  branch          Branch          @relation(fields: [branchId], references: [id])
  category        ExpenseCategory @relation(fields: [categoryId], references: [id])
  purchaseRecord  PurchaseRecord? @relation(fields: [purchaseRecordId], references: [id])
  createdByStaff  Staff           @relation("ExpenseCreatedBy", fields: [createdByStaffId], references: [id])
  approvedByStaff Staff?          @relation("ExpenseApprovedBy", fields: [approvedByStaffId], references: [id])

  @@index([branchId])
  @@index([categoryId])
}

// ---------------------------------------------------------------------------
// Milestone 11 — Staff Attendance & Departments
// ---------------------------------------------------------------------------

/// PRD §5.13 clock-in/clock-out attendance, per staff member per shift.
/// `date` is a UTC-midnight day marker (same convention as
/// Booking.checkInDate) that groups records into "a day's attendance
/// record" (M11 DoD) — set once at clock-in and never recomputed from
/// clockOut, so an overnight shift still files under the day it started.
/// One open (clockOut null) attendance row per staff at a time is enforced
/// in AttendanceService, not here — the same "can't express a partial
/// unique index in Prisma's schema DSL" situation as Shift's one-open-shift
/// rule.
model Attendance {
  id       String    @id @default(uuid())
  branchId String
  staffId  String
  clockIn  DateTime  @default(now())
  clockOut DateTime?
  date     DateTime

  branch Branch @relation(fields: [branchId], references: [id])
  staff  Staff  @relation(fields: [staffId], references: [id])

  @@index([branchId])
  @@index([staffId, date])
}
