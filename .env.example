# Local Docker Compose infra credentials.
# App-level env (DATABASE_URL, REDIS_URL, ...) lives in apps/api/.env and apps/web/.env
# — see their .env.example files. These just need to point at the same values below.

POSTGRES_USER=nugget
POSTGRES_PASSWORD=nugget
POSTGRES_DB=nugget_dev
POSTGRES_PORT=5432

REDIS_PORT=6379
